<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Upper Orbital Arc -->
    <path
        android:pathData="M 54,28 A 26,26 0 0,1 80,54 A 26,26 0 0,1 74,69"
        android:strokeWidth="6.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#3987FF" />
                <item android:offset="1.0" android:color="#24D5C5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower Orbital Arc -->
    <path
        android:pathData="M 54,80 A 26,26 0 0,1 28,54 A 26,26 0 0,1 34,39"
        android:strokeWidth="6.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#3987FF" />
                <item android:offset="1.0" android:color="#24D5C5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Vault Disc -->
    <path
        android:pathData="M 54,54 m -13,0 a 13,13 0 1,1 26,0 a 13,13 0 1,1 -26,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="41"
                android:endX="67"
                android:endY="67"
                android:type="linear">
                <item android:offset="0.0" android:color="#3987FF" />
                <item android:offset="1.0" android:color="#24D5C5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Interior Aperture Cutout -->
    <path
        android:fillColor="#071426"
        android:pathData="M 54,54 m -8.5,0 a 8.5,8.5 0 1,1 17,0 a 8.5,8.5 0 1,1 -17,0" />

    <!-- Shutter Facet Wedge -->
    <path
        android:pathData="M 54,54 L 47,47 A 8.5,8.5 0 0,1 61,47 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47"
                android:startY="47"
                android:endX="61"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#3987FF" />
                <item android:offset="1.0" android:color="#24D5C5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Pupil Point -->
    <path
        android:fillColor="#24D5C5"
        android:pathData="M 54,54 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0" />
</vector>
